# Porta do servidor (API + WebSocket + front-end no mesmo processo)
PORT=3001

# Porta do WebSocket de hot reload do Vite (somente em desenvolvimento)
HMR_PORT=24679

# Caminho do arquivo SQLite
DB_PATH=data/chat.db

# Segredo para assinar os tokens JWT (obrigatório em produção, mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Pasta onde os arquivos enviados são salvos e tamanho máximo por arquivo (MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
