{
  "name": "chat-bot-monolito",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de comunicação em tempo real: Node.js (Express + Socket.IO + SQLite) servindo um front-end React, tudo em TypeScript",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node build/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/dropzone": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sass-embedded": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
